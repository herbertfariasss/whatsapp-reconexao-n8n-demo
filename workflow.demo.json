    {
      "parameters": {
        "jsCode": "const body = $('Webhook1').first().json.body || {};\nconst msg = body.message || {};\nconst chatid = msg.chatid || '';\n\nlet chave = '';\ntry {\n  chave = decodeURIComponent(String(msg.buttonOrListid || '').replace(/^sim_/, ''));\n} catch (e) {}\n\nconst row = $input.first().json || {};\nconst token = row.token || '';\nconst nome = String(chave || row.instanceName || '').toUpperCase();\nconst quemClicou = msg.senderName || 'alguém';\n\n// Endereço da Zaptos da instância (servidor /whatsapp, /whatsapp2... ). Padrão: /whatsapp/\nlet baseUrl = String(row.baseUrl || 'https://api-zaptos.example.invalid/whatsapp/').trim();\nif (!baseUrl.endsWith('/')) baseUrl += '/';\n\nlet erro = '';\nif (!token) {\n  erro = 'Ainda não tenho o token da instância ' + nome + '. Ele é salvo automaticamente no primeiro evento de conexão dela (ou pode ser cadastrado na tabela zaptos_instancias).';\n}\n\nreturn [{\n  json: {\n    chatid,\n    quemClicou,\n    instanceName: nome,\n    instanceToken: token,\n    baseUrl,\n    found: !!token,\n    erro,\n    alertToken: body.token\n  }\n}];"
      },

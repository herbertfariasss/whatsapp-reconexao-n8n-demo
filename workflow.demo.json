    {
      "parameters": {
        "jsCode": "const ctx = $('Identificar instância').first().json;\nconst st = $input.first().json;\n\nconst find = (obj, re) => {\n  let r;\n  const walk = (o) => {\n    if (r || o == null) return;\n    if (typeof o === 'object') {\n      for (const [k, v] of Object.entries(o)) {\n        if (re.test(k) && typeof v === 'string' && v.length > 50) { r = v; return; }\n        walk(v);\n      }\n    }\n  };\n  walk(obj);\n  return r;\n};\n\nconst qr = find(st, /qr/i);\nconst erro = qr ? '' : 'Não consegui gerar o QR code da instância ' + ctx.instanceName + '. Use o link de reconexão do painel da Zaptos.';\nconst caption = '📷 *QR code - ' + ctx.instanceName + '*\\n\\nEscaneie agora (expira em ~30 segundos):\\nWhatsApp > Aparelhos conectados > Conectar um aparelho.\\n\\nSolicitado por: ' + ctx.quemClicou;\n\nreturn [{ json: { chatid: ctx.chatid, alertToken: ctx.alertToken, hasQr: !!qr, qr: qr || '', caption, erro } }];"
      },
